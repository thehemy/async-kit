{
  "name": "async-kit",
  "version": "1.0.0",
  "description": "Tiny, dependency-free async helpers for TypeScript: retry, timeout, concurrency limit, memoize",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "files": ["dist/src"],
